{
  "name": "@nqhd3v/coros-connect",
  "version": "1.0.9",
  "description": "query health data from COROS as an MCP client",
  "scripts": {
    "clean": "rimraf dist",
    "prebuild": "npm run clean",
    "build": "tsc",
    "test": "vitest",
    "test:run": "vitest run",
    "typecheck": "tsc -p tsconfig.test.json"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/nqhd3v/coros-connect"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./crypto": {
      "types": "./dist/crypto.d.ts",
      "default": "./dist/crypto.js"
    }
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "coros",
    "coros-connect",
    "mcp"
  ],
  "author": {
    "email": "nqh.d3v@gmail.com",
    "name": "Huy Nguyen"
  },
  "license": "ISC",
  "type": "module",
  "devDependencies": {
    "@types/node": "^26.6.6",
    "rimraf": "^6.1.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2"
  }
}
